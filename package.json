{
  "name": "dev-browser",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start-server": "bun run scripts/start-server.ts",
    "start-extension": "bun run scripts/start-relay.ts",
    "dev": "bun --watch run src/index.ts",
    "test": "bun test ./src",
    "test:watch": "bun test --watch ./src",
    "test:extension": "cd extension && bun run test:run",
    "reinstall": "rm -rf node_modules bun.lock && bun install"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@hono/node-ws": "^1.3.0",
    "express": "^5.2.1",
    "hono": "^4.11.9",
    "playwright": "^1.58.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.57.1"
  }
}
